PORT=4000
HOST=0.0.0.0
DATABASE_URL=postgresql://user:password@host/database?sslmode=require
APP_AUTH_SECRET=replace-with-32-char-secret
GITHUB_APP_ID=123456
# Full PEM on one line with \n, or quoted multi-line block (see env-to-secrets-json.mjs)
GITHUB_APP_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
GITHUB_WEBHOOK_SECRET=replace-me
GITHUB_CLIENT_ID=replace-me
GITHUB_CLIENT_SECRET=replace-me
ASANA_CLIENT_ID=replace-me
ASANA_CLIENT_SECRET=replace-me
ASANA_REDIRECT_URI=http://localhost:4000/api/integrations/asana/callback
FRONTEND_URL=http://localhost:5173
# Production: set FRONTEND_URL=https://devops.emsoft.com
# Route53 health check for webapp.emsoft.com (CloudWatch TimeToFirstByte)
ROUTE53_HEALTH_CHECK_ID=5021ff48-e1e7-4f02-af89-28d54734cb06
ROUTE53_METRICS_REGION=us-east-1
REACHABILITY_CACHE_TTL_SECONDS=3600
# CloudWatch credentials (local backend/.env; on ECS use Secrets Manager or task role)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
# Cloudflare zone analytics (landing globe traffic mode)
# Token needs Zone → Analytics → Read on this zone (not Cache Purge only). See infra/cloudflare/README.md
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ZONE_ID=
CLOUDFLARE_TRAFFIC_CACHE_TTL_SECONDS=3600
# GitHub App settings > Post installation > Setup URL (required):
#   https://devops.emsoft.com/api/integrations/github/setup
